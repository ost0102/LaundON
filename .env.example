# Signs admin/user session cookies (HMAC-SHA256). Any long random string;
# rotating it logs everyone out.
AUTH_SECRET=

# Gemini API key for the AI laundry assistant (chat + embeddings for RAG).
# Server-only - never exposed to the client. Free tier, no card required -
# get one at aistudio.google.com/apikey.
GEMINI_API_KEY=

# OpenAI API key - only needed if lib/ai/index.ts and lib/rag/index.ts are
# switched back to OpenAIProvider/OpenAIEmbeddingProvider. Unused by default.
OPENAI_API_KEY=

# Base URL for the LaundON API.
# Empty string targets this Next.js app's own route handlers (mock IoT API).
# Point this at the real IoT backend's URL once it's available.
NEXT_PUBLIC_API_BASE_URL=

# SMTP server for sending real signup verification emails. Leave empty to
# fall back to the dev-only mock, which shows the code on screen instead of
# emailing it. Works with any mailbox, so verification codes can be sent to
# any address the user enters (no sender-domain verification needed).
#
# Gmail example (requires an App Password: Google Account > Security >
# 2-Step Verification > App passwords):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
#
# Naver example (requires enabling POP3/SMTP under 네이버메일 > 환경설정):
#   SMTP_HOST=smtp.naver.com
#   SMTP_PORT=465
#   SMTP_USER=you@naver.com
#   SMTP_PASS=your-naver-password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
